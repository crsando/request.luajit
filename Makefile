.DEFAULT_GOAL := build

CMAKE ?= cmake
BUILD_DIR ?= build
BUILD_TYPE ?= Release
LUAJIT ?= luajit

# Install next to the luajit that will load the module: /opt/homebrew with
# Homebrew on Apple Silicon, /usr/local for a source build on Linux.
LUAJIT_BIN := $(shell command -v $(LUAJIT) 2>/dev/null)
LUAJIT_PREFIX := $(patsubst %/bin/,%,$(dir $(LUAJIT_BIN)))
ifeq ($(strip $(LUAJIT_PREFIX)),)
LUAJIT_PREFIX := /usr/local
endif
PREFIX ?= $(LUAJIT_PREFIX)

.PHONY: all configure build debug release test install asan asan-test clean help

all: build

configure:
	$(CMAKE) -S . -B $(BUILD_DIR) -DCMAKE_BUILD_TYPE=$(BUILD_TYPE)

build: configure
	$(CMAKE) --build $(BUILD_DIR) --parallel

debug:
	$(MAKE) BUILD_TYPE=Debug build

release:
	$(MAKE) BUILD_TYPE=Release build

test:
	REQUEST_LUAJIT="$(LUAJIT)" REQUEST_BUILD_DIR="$(BUILD_DIR)" REQUEST_BUILD_TYPE="$(BUILD_TYPE)" ./tests/run.sh

install: build
	$(CMAKE) --install $(BUILD_DIR) --prefix $(PREFIX)

asan:
	$(CMAKE) -S . -B build-asan \
		-DCMAKE_BUILD_TYPE=Debug \
		-DREQUEST_ENABLE_SANITIZERS=ON
	$(CMAKE) --build build-asan --parallel

asan-test: asan
	@if test "$$(uname -s)" = "Darwin"; then \
		ASAN_OPTIONS=verify_interceptors=0:detect_leaks=0 \
		UBSAN_OPTIONS=halt_on_error=1 \
		REQUEST_BUILD_DIR=build-asan REQUEST_BUILD_TYPE=Debug \
		REQUEST_LUAJIT_PRELOAD="$$(clang --print-file-name=libclang_rt.asan_osx_dynamic.dylib)" \
		./tests/run.sh; \
	else \
		ASAN_OPTIONS=detect_leaks=0:verify_asan_link_order=0 \
		UBSAN_OPTIONS=halt_on_error=1 \
		REQUEST_BUILD_DIR=build-asan REQUEST_BUILD_TYPE=Debug \
		REQUEST_LUAJIT_PRELOAD="$$(cc -print-file-name=libasan.so)" \
		./tests/run.sh; \
	fi

clean:
	@if test -f $(BUILD_DIR)/Makefile; then \
		$(CMAKE) --build $(BUILD_DIR) --target clean; \
	fi

help:
	@printf '%s\n' \
		'make build   Build the native module (BUILD_DIR=build BUILD_TYPE=Release)' \
		'make test    Build and run the local HTTP/HTTPS test suite' \
		'make install Build and install under PREFIX (default: prefix of luajit in PATH)' \
		'make asan    Configure and build with AddressSanitizer/UBSan' \
		'make asan-test Run the test suite with AddressSanitizer/UBSan' \
		'make clean   Remove files generated by the current CMake build'
